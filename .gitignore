# Python build/cache artifacts — never source
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime databases — never committed (per-test ledger files)
*.sqlite3
*.sqlite
*.db
ledger.db
!tests/fixtures/**/*.sqlite3

# Run reports / runtime state
reports/
run_reports/
out/
*.log
logs/
audit-exports/
.netops-snapshots/

# Environment / credentials — never committed (L11)
.env
.netrc
*.pem
*.key

# Editor / OS noise
.idea/
.vscode/
.DS_Store
