{
  "$schema_ref": "../../../docs/D0/06-architecture-overview.md",
  "vendor_os": "ios-xe",
  "verified": true,
  "verified_at": "2026-09-11",
  "note": "Lab-verified for IOS-XE 16.x+ and 17.x. Templates emit Cisco IOS syntax that the parser/renderer shares with the allowlist.",
  "wrappers": { "enter_config": ["enable", "configure terminal"], "exit_config": ["end"] },
  "features": {
    "vlan": { "commands": ["vlan {vlan_id}", " name {name}"] },
    "svi": { "commands": ["interface Vlan{vlan_id}", " ip address {address}"], "prelude": ["ip routing"] },
    "trunk": { "commands": ["interface {interface}", " switchport trunk encapsulation dot1q", " switchport mode trunk", " switchport trunk allowed vlan {allowed_vlans_csv}"] },
    "access": { "commands": ["interface {interface}", " switchport mode access", " switchport access vlan {vlan_id}"] },
    "hostname": { "commands": ["hostname {hostname}"] },
    "interface": { "commands": ["interface {interface}", " description {description}"] }
  }
}
