{
  "name": "netops-autopilot-pc",
  "version": "6.0.0",
  "description": "NetOps Autopilot V6 — مهندس شبكات آلي حقيقي للكمبيوتر — دقة مجهرية 100%",
  "main": "main.js",
  "author": "NetOps Autopilot — CCIE/JNCIE 30 years",
  "homepage": "https://netops-autopilot.local",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.netops.autopilot",
    "productName": "NetOps Autopilot",
    "copyright": "Copyright © 2026 NetOps Autopilot — Evidence-First",
    "directories": {
      "output": "../dist/installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "../src/**/*",
      "../VERSION"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png",
      "publisherName": "NetOps Autopilot"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.png",
      "category": "public.app-category.networking"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetOps Autopilot"
    },
    "portable": {
      "artifactName": "NetOps-Autopilot-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.9.0"
  }
}
