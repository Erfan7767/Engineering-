{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://netops-autopilot.local/schemas/change.schema.json",
  "title": "Change",
  "description": "FSM-2 entity. Carries scope lock (L09), intent refs, IR refs, gate trail. Never contains raw credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id", "state", "title", "scope_set", "network_intent_ref",
    "gate_class", "created_by", "created_at"
  ],
  "properties": {
    "change_id": { "type": "string", "format": "uuid" },
    "state": {
      "enum": ["DRAFT", "VALIDATED", "PLANNED", "RISK_ASSESSED", "AUTHORIZED",
               "ARMED", "APPLYING", "APPLIED", "VERIFYING", "VERIFIED",
               "CLEANED", "CLOSED", "REJECTED", "PARTIAL", "FAILED",
               "ROLLED_BACK", "RECOVERING", "MANUAL_REQUIRED"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "capability_domain": { "enum": ["AUTOMATED", "ASSISTED", "HUMAN_TASK"], "description": "Announced classification (docs/D0/09)." },
    "scope_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_type", "entity_ref"],
        "properties": {
          "entity_type": { "enum": ["DEVICE", "CHASSIS", "STACK_MEMBER", "INTERFACE", "VLAN", "LINK", "SERVICE", "POLICY", "SITE", "RACK"] },
          "entity_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "network_intent_ref": { "type": "string" },
    "config_ir_ref": { "type": ["string", "null"], "description": "Populated at VALIDATED (E09)." },
    "dag_ref": { "type": ["string", "null"], "description": "Populated at PLANNED (E12)." },
    "blast_radius_ref": { "type": ["string", "null"], "description": "Populated at RISK_ASSESSED (E13)." },
    "gate_class": { "enum": ["READ_ONLY", "LOW_RISK", "HIGH_RISK", "IRREVERSIBLE", "DESTRUCTIVE"] },
    "gate_verdicts": { "type": "array", "items": { "$ref": "gate_verdict.schema.json" } },
    "rollback_ref": { "type": ["string", "null"], "description": "FSM-3 object id; must be READY before ARMED (ADR-0009)." },
    "maintenance_window_ref": { "type": ["string", "null"] },
    "temporary_resources": { "type": "array", "items": { "type": "string" }, "default": [] },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["ENGINE", "HUMAN", "AGENT"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": ["string", "null"] },
    "failure_report": {
      "type": ["object", "null"],
      "description": "Mandatory when state in {FAILED, PARTIAL} (T4): counts + causes.",
      "additionalProperties": false,
      "required": ["class", "failed_count", "total_count", "causes"],
      "properties": {
        "class": { "enum": ["PARTIAL", "FAILED", "ROLLED_BACK", "MANUAL_REQUIRED"] },
        "failed_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 1 },
        "causes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "state": { "enum": ["FAILED", "PARTIAL"] } } },
      "then": { "required": ["failure_report"] } }
  ]
}
