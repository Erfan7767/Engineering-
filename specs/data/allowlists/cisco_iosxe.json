    "CONFIG_REVERSIBLE": {
      "notes": "Lab-verified reversible templates; rollback via 'no <cmd>' or 'default <cmd>'. All entries pass syntax check on IOS-XE 16.x+ / 17.x.",
      "entries": [
        {
          "template": "hostname <hostname>",
          "purpose": "set device hostname",
          "fields": [
            "hostname"
          ],
          "rollback": "no hostname",
          "scope": "system"
        },
        {
          "template": "vlan <vlan_id>",
          "purpose": "create VLAN",
          "fields": [
            "vlan_id"
          ],
          "rollback": "no vlan <vlan_id>",
          "scope": "vlan",
          "enters_mode": true
        },
        {
          "template": "name <name>",
          "purpose": "set VLAN name (in vlan context)",
          "fields": [
            "name"
          ],
          "rollback": "no name",
          "scope": "vlan"
        },
        {
          "template": "interface Vlan<vlan_id>",
          "purpose": "enter SVI",
          "fields": [
            "vlan_id"
          ],
          "rollback": "default interface Vlan<vlan_id>",
          "scope": "svi",
          "enters_mode": true
        },
        {
          "template": "ip address <ip> <mask>",
          "purpose": "set SVI IPv4",
          "fields": [
            "ip",
            "mask"
          ],
          "rollback": "no ip address",
          "scope": "svi"
        },
        {
          "template": "no shutdown",
          "purpose": "enable interface",
          "fields": [],
          "rollback": "shutdown",
          "scope": "interface"
        },
        {
          "template": "interface <intf>",
          "purpose": "enter interface",
          "fields": [
            "intf"
          ],
          "rollback": "default interface <intf>",
          "scope": "interface",
          "enters_mode": true
        },
        {
          "template": "description <text>",
          "purpose": "set interface description",
          "fields": [
            "text"
          ],
          "rollback": "no description",
          "scope": "interface"
        },
        {
          "template": "switchport mode access",
          "purpose": "set access mode",
          "fields": [],
          "rollback": "no switchport mode",
          "scope": "interface"
        },
        {
          "template": "switchport access vlan <vlan_id>",
          "purpose": "assign access VLAN",
          "fields": [
            "vlan_id"
          ],
          "rollback": "no switchport access vlan",
          "scope": "interface"
        },
        {
          "template": "switchport mode trunk",
          "purpose": "set trunk mode",
          "fields": [],
          "rollback": "no switchport mode",
          "scope": "interface"
        },
        {
          "template": "switchport trunk allowed vlan <list>",
          "purpose": "set trunk allowed VLANs",
          "fields": [
            "list"
          ],
          "rollback": "no switchport trunk allowed vlan",
          "scope": "interface"
        },
        {
          "template": "switchport trunk native vlan <vlan_id>",
          "purpose": "set trunk native VLAN",
          "fields": [
            "vlan_id"
          ],
          "rollback": "no switchport trunk native vlan",
          "scope": "interface"
        },
        {
          "template": "switchport trunk encapsulation dot1q",
          "purpose": "trunk 802.1Q encapsulation (emitted by the trunk renderer)",
          "rollback": "no switchport trunk encapsulation"
        },
        {
          "template": "ip routing",
          "purpose": "enable L3 routing on multilayer switch",
          "fields": [],
          "rollback": "no ip routing",
          "scope": "system"
        },
        {
          "template": "interface Loopback0",
          "purpose": "enter loopback 0 (router-id source)",
          "fields": [],
          "rollback": "no interface Loopback0",
          "scope": "interface",
          "enters_mode": true
        },
        {
          "template": "ip address <ip> 255.255.255.255",
          "purpose": "set /32 on loopback",
          "fields": [
            "ip"
          ],
          "rollback": "no ip address",
          "scope": "interface"
        },
        {
          "template": "ip dhcp excluded-address <first> <last>",
          "purpose": "reserve addresses DHCP must not hand out",
          "rollback": "no ip dhcp excluded-address <first> <last>"
        },
        {
          "template": "ip dhcp pool <name>",
          "purpose": "create a DHCP pool",
          "rollback": "no ip dhcp pool <name>",
          "enters_mode": true
        },
        {
          "template": "network <net> <mask>",
          "purpose": "pool network and mask",
          "rollback": "no network"
        },
        {
          "template": "default-router <gw>",
          "purpose": "pool default gateway",
          "rollback": "no default-router"
        },
        {
          "template": "dns-server <args>",
          "purpose": "pool DNS resolvers (IOS takes a space-separated list)",
          "rollback": "no dns-server"
        },
        {
          "template": "domain-name <name>",
          "purpose": "pool DNS domain",
          "rollback": "no domain-name"
        }
      ]
    },
    "CONFIG_HIGH_RISK": {
