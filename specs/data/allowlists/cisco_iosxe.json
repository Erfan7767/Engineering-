    "DESTRUCTIVE": {
      "entries": [
        {
          "template": "rommon-recovery-sequence",
          "purpose": "never executed by platform; HUMAN_TASK instructions only",
          "fields": []
        }
      ]
    },
    "FORBIDDEN": {
      "entries": [
        {
          "template": "erase <args>",
          "reason": "destructive"
        },
        {
          "template": "write erase",
          "reason": "destructive"
        },
        {
          "template": "format <args>",
          "reason": "destructive"
        },
        {
          "template": "delete /force /recursive <args>",
          "reason": "artifact destruction"
        },
        {
          "template": "reload",
          "reason": "service-disruptive; needs explicit human task with maintenance window"
        },
        {
          "template": "no router",
          "reason": "bare `no router` is refused; the precise declared inverses `no router ospf <pid>` / `no router bgp <asn>` remain available so a routing change can still be rolled back (Phase V)"
        }
      ]
    },
    "CONFIG_PERSIST": {
      "entries": [
        {
          "template": "write memory",
          "purpose": "copy the running-config to startup-config so the change survives a reload",
          "rollback": ""
        }
      ]
    }
  },
  "note": "Phase V: `enters_mode` marks templates that put IOS into a CLI sub-mode, so the executor can issue an inverse at the depth the original command ran at."
}
