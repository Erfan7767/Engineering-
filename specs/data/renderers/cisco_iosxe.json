    "trunk": { "commands": ["interface {interface}", " switchport trunk encapsulation dot1q", " switchport mode trunk", " switchport trunk allowed vlan {allowed_vlans_csv}"] },
    "access": { "commands": ["interface {interface}", " switchport mode access", " switchport access vlan {vlan_id}"] }
  }
